# ----------------------------------------------------------------------
# Generated benchmark artifacts
# ----------------------------------------------------------------------

# Generated synthetic Git repositories.
# These are derived from scenario.yml files and should be reproducible.
generated-input-repos/

# Outputs from SZZ tools or benchmark runs.
generated-szz-results/

# Generated metadata, logs, temporary derived files.
generated-metadata/

# Temporary working directories.
tmp/
temp/

# Optional local experiment outputs.
results/
outputs/

# Local archive snapshots.
SZZBench.zip


